.vercel

# Merged from .gitignore_draft
# Secret / credential files
# T-0.4 / F-39: precise patterns — broad globs (*key*, *token*, *secret*)
# would wrongly ignore legit source files like tokenizer.ts
*.key
*.pem
secrets.*

# Logs (*.log catch-all)
*.log

# Python (if any scripts are added)
__pycache__/
*.pyc
venv/
.venv/

# Vitest / test artefacts
coverage/
.vitest-cache/

# Build dist output
dist/

# Smoke harness artefacts (regenerated on each run)
smoke-report.json
smoke-report.md
