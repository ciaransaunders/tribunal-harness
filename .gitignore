# Node / Next.js / Vite
node_modules/
.next/
out/
dist/

# Environment & secrets
# T-0.4 / F-39: precise patterns — broad globs (*key*, *token*, *secret*)
# would wrongly ignore legit source files like tokenizer.ts
.env*
*.key
*.pem
secrets.*

# Data (may contain personal/sensitive information)
data/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# OS
.DS_Store
Thumbs.db

# Package-manager / tooling cache artefacts (T-0.4 / F-36)
_cacache/
_update-notifier-last-checked

# Python (if scripts present)
__pycache__/
*.pyc
venv/
.venv/

# Vitest / test cache
.vitest-cache/
coverage/

# IDE
.idea/
*.swp
*.swo

# Local-only MCP dev config (machine-specific absolute path)
.mcp.json
